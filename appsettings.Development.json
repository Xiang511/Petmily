{
    // 開發環境開啟 Trace（Serilog 的 Verbose）：ActionLoggingFilter 會記錄方法進入/離開與已遮罩的 body。
    // MinimumLevel.Override 沿用 appsettings.json，Microsoft/System 的噪音仍維持 Warning。
    "Serilog": {
        "MinimumLevel": {
            "Default": "Verbose",
            "Override": {
                // Default 開到 Verbose 後，框架本身的 Debug 訊息（EF 連線、Hosting）會變很吵，統一壓回 Warning
                "Microsoft": "Warning"
            }
        }
    },
    // Microsoft.Extensions.Logging 的篩選規則也要放寬，否則 Trace 會在進入 Serilog 前被濾掉
    "Logging": {
        "LogLevel": {
            "Default": "Trace",
            "Microsoft.AspNetCore": "Warning"
        }
    }
}
